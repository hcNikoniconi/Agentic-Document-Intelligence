# Application paths. Relative paths are resolved by the application process.
APP_BASE_DIR=.
INPUT_ROOT=./data
TEMPLATE_DIR=./templates
OUTPUT_ROOT=./output

# OpenAI-compatible model service.
# This can point to a self-hosted vLLM server or an external compatible API.
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_API_KEY=replace-me
MODEL_NAME=qwen3-8b
MODEL_TIMEOUT_SECONDS=120

# Qwen / Alibaba Cloud Model Studio OpenAI-compatible example:
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_API_KEY=your-dashscope-api-key
# MODEL_NAME=qwen-vl-max
# MODEL_TIMEOUT_SECONDS=180

# VLM pipeline options.
VLM_MAX_PAGES_PER_FILE=4
VLM_MAX_TOKENS=4096
# Optional image-token controls for Qwen-compatible VLM APIs.
# Leave empty unless you want to tune quality/cost.
VLM_MIN_PIXELS=
VLM_MAX_PIXELS=

# Gradio service. Keep 127.0.0.1 when accessing through an SSH tunnel.
APP_HOST=127.0.0.1
APP_PORT=7860
